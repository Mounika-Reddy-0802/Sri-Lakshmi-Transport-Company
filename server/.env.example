# SLTC API environment variables.
# Copy to `server/.env` and fill in real values. Never commit `.env`.

# --- Database ---
# MongoDB Atlas connection string, including the database name.
MONGODB_URI=

# --- Auth (Phase 3) ---
# Long random strings. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
# Origin of the Next.js frontend that is allowed to call this API.
CLIENT_ORIGIN=http://localhost:3000

# --- Payments (Phase 6) ---
# Razorpay TEST credentials. Switch to live keys only at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Server ---
PORT=4000
NODE_ENV=development
